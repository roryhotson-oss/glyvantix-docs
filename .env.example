# =====================================================================
# GLYvantix Docs — environment variables (template)
# =====================================================================
# Copy this file to `.env` for local dev, or set these as environment
# variables in your hosting provider (Vercel/Fasthosts/etc.) for prod.
#
# All secrets below are PLACEHOLDERS. Replace with your real values.
# Never commit your real `.env` to git.

# ---------------------------------------------------------------------
# Database (REQUIRED for production on Vercel / serverless)
# ---------------------------------------------------------------------
# PostgreSQL connection string. Vercel cannot use SQLite (no persistent
# filesystem). Provision a free Postgres at one of:
#   - Neon          https://neon.tech      (recommended, generous free tier)
#   - Supabase      https://supabase.com
#   - Vercel Postgres (Vercel dashboard → Storage → Postgres)
#
# Example format:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PLACEHOLDER_PASSWORD@HOST:5432/DATABASE?schema=public"

# For local dev you can swap prisma/schema.prisma provider to "sqlite"
# and use a local file:
# DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------
# SEO / domain protection (REQUIRED for production)
# ---------------------------------------------------------------------
# The canonical production URL (no trailing slash). Google uses this to
# deduplicate when multiple domains point at this app.
# For this deployment, use the docs subdomain:
SITE_CANONICAL_URL="https://docs.glyvantix.co.uk"

# Whether search engines are allowed to index this deployment.
#   "true"  → production: robots.txt allows all, sitemap.xml served
#   unset   → dev/staging/sandbox: robots.txt blocks all, sitemap returns 404
#           → layout.tsx emits <meta name="robots" content="noindex,nofollow">
# NEVER set this to "true" on a dev/staging/sandbox URL.
SITE_INDEXABLE="true"

# ---------------------------------------------------------------------
# AI generation (server-side only)
# ---------------------------------------------------------------------
# Any OpenAI-compatible provider can be used. Never expose these values with
# NEXT_PUBLIC_ and never commit a real API key.
AI_API_KEY="PLACEHOLDER_SERVER_SIDE_KEY"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------
# Payments (FUTURE — only when you re-introduce commerce)
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_PLACEHOLDER"
# STRIPE_PUBLISHABLE_KEY="pk_test_PLACEHOLDER"
# STRIPE_WEBHOOK_SECRET="whsec_PLACEHOLDER"

# ---------------------------------------------------------------------
# Auth (FUTURE — only when you add real users beyond the demo user)
# ---------------------------------------------------------------------
# NEXTAUTH_SECRET="PLACEHOLDER_GENERATE_WITH_openssl_rand_base64_32"
# NEXTAUTH_URL="https://docs.glyvantix.co.uk"
# GOOGLE_CLIENT_ID="PLACEHOLDER"
# GOOGLE_CLIENT_SECRET="PLACEHOLDER"
